---
const narrativeFields = ['thesis', 'market_pricing', 'catalyst', 'invalidation', 'target', 'notes'];
---
<section class="workbench" id="portfolio">
  <div class="section-heading"><h2>Shadow fund ledger</h2><button class="button secondary" id="position-new"><i data-lucide="plus"></i>Add position</button></div>
  <p class="method-note">CAD base currency. Manual marks. P&amp;L = direction &times; entry notional &times; (current / entry price - 1). This linear return approximation excludes financing, FX translation, margin and contract multipliers.</p>
  <div class="metrics compact"><div><span class="metric-label">NAV / CAD</span><strong id="portfolio-nav"></strong></div><div><span class="metric-label">TOTAL RETURN</span><strong id="portfolio-return"></strong></div><div><span class="metric-label">REALIZED P&amp;L</span><strong id="portfolio-realized"></strong></div><div><span class="metric-label">UNREALIZED P&amp;L</span><strong id="portfolio-unrealized"></strong></div></div>
  <div class="table-scroll"><table><thead><tr><th>Instrument / Theme</th><th>Status</th><th>Notional (CAD)</th><th>Entry / Mark</th><th>P&amp;L (CAD)</th><th>Actions</th></tr></thead><tbody id="position-list"></tbody></table></div>
  <div class="dashboard-grid"><section><div class="section-heading"><h3>Gross / net exposure</h3><select id="exposure-group" aria-label="Exposure grouping"><option value="asset_class">Asset class</option><option value="country">Country</option><option value="theme">Theme</option></select></div><div id="exposure-list"></div></section><section><div class="section-heading"><h3>NAV history</h3><button class="icon-button" id="nav-snapshot" title="Record today's NAV" aria-label="Record today's NAV"><i data-lucide="camera"></i></button></div><div id="nav-chart"></div><p id="portfolio-stats" class="muted"></p><div id="nav-history"></div></section></div>
  <dialog id="position-dialog"><form id="position-form" class="stack"><div class="section-heading"><h2 id="position-title">New position</h2><button type="button" class="icon-button" id="position-cancel" aria-label="Cancel position" title="Cancel"><i data-lucide="x"></i></button></div><input type="hidden" name="trade_id" /><label>Timestamped memo<select name="memo_id" id="position-memo" required></select></label><div class="form-grid"><label>Instrument<input name="instrument" required /></label><label>Direction<select name="direction"><option value="long">Long</option><option value="short">Short</option></select></label><label>Asset class<select name="asset_class"><option>Rates</option><option>FX</option><option>Equity</option><option>Commodity</option><option>Credit</option><option>Other</option></select></label><label>Country<input name="country" required /></label><label>Theme<input name="theme" required /></label><label>Notional (CAD)<input name="notional" type="number" min="0.01" step="any" required /></label><label>Entry price<input name="entry_price" type="number" min="0.000001" step="any" required /></label><label>Current / exit price<input name="current_price" type="number" min="0" step="any" required /></label><label>DV01 (CAD / bp)<input name="dv01" type="number" step="any" value="0" /></label><label>Volatility target (%)<input name="vol_target" type="number" min="0" step="any" value="6" /></label><label>Review date<input name="review_date" type="date" required /></label><label>Carry estimate (CAD)<input name="carry_estimate" type="number" step="any" value="0" /></label>{['bull', 'base', 'bear'].map(s => <label>{s.charAt(0).toUpperCase() + s.slice(1)} P&amp;L (bp of NAV)<input name={`${s}_pnl`} type="number" step="any" required /></label>)}</div>{narrativeFields.map(name => <label>{name.replaceAll('_', ' ')}<textarea name={name} rows="2" required={name !== 'notes'}></textarea></label>)}<label><input type="checkbox" name="close_position" />Close position at current mark</label><p class="method-note">Opening decisions and the entry memo are frozen when saved. Subsequent updates change marks, notes and review date only.</p><button type="submit" class="button"><i data-lucide="save"></i>Save position</button></form></dialog>
</section>

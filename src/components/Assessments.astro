---
import { getCurriculum } from '../lib/curriculum';
const { weeks } = await getCurriculum();
---
<section class="workbench" id="assessments"><div class="section-heading"><h2>Weekly self-test</h2><label class="inline-label">Week<select id="assessment-week">{weeks.map(w => <option value={w.week}>{w.week}</option>)}</select></label></div><div class="score-summary"><strong id="weekly-score">0 / 10</strong><span id="weekly-result">Not assessed</span></div><div id="self-test-questions"></div></section>
<section class="workbench" id="pm-drill"><div class="section-heading"><h2>PM interview drill</h2><label class="inline-label">Timer<select id="drill-duration"><option value="0">Off</option><option value="60">60 seconds</option><option value="180">3 minutes</option><option value="300">5 minutes</option></select></label></div><div class="drill-prompt"><span class="eyebrow">INVESTMENT COMMITTEE</span><h3 id="drill-question">Ready for your next question.</h3><output id="drill-clock" aria-live="off"></output></div><button id="drill-start" class="button secondary"><i data-lucide="shuffle"></i>New question</button><form id="drill-form" class="stack"><label>Your response<textarea name="answer" rows="5" required disabled></textarea></label><fieldset class="score-options"><legend>Self-score</legend><label><input type="radio" name="score" value="0" required disabled />0 / Cannot do</label><label><input type="radio" name="score" value="1" disabled />1 / Partial</label><label><input type="radio" name="score" value="2" disabled />2 / Fluent</label></fieldset><button class="button" type="submit" disabled><i data-lucide="save"></i>Save response</button></form><h3>Practice history</h3><div id="drill-history"></div></section>

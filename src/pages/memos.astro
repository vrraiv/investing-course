---
import Layout from '../layouts/Layout.astro';
import { getCurriculum } from '../lib/curriculum';
const { memoFields } = await getCurriculum();
---
<Layout title="Trade memos" eyebrow="Investment process / Decision record">
  <button slot="actions" id="memo-new" class="button secondary"><i data-lucide="plus"></i>New memo</button>
  <div class="memo-layout"><aside><div class="section-heading"><h2>Casebook</h2></div><div id="memo-list"></div></aside><section><div class="section-heading"><h2 id="memo-form-title">New trade memo</h2><span class="tag" id="memo-status">DRAFT</span></div><form id="memo-form" class="stack"><input name="id" type="hidden" /><label>Trade title<input name="title" required maxlength="180" /></label><div class="form-grid"><label>Date<input name="date" type="date" required /></label><label>Review date<input name="reviewDate" type="date" /></label></div>{memoFields.map((field, i) => <label>{field.name}<small>{field.hint}</small><textarea name={`field-${i}`} rows={i === 2 ? 4 : 2} required={i === 0}></textarea></label>)}<label>Post-mortem<textarea name="postMortem" rows="4"></textarea></label><div class="button-row"><button class="button" type="submit"><i data-lucide="save"></i>Save memo</button><button class="icon-button" type="button" id="memo-duplicate" title="Duplicate saved memo" aria-label="Duplicate saved memo"><i data-lucide="copy"></i></button><button class="icon-button" type="button" id="memo-export" title="Export saved memo as Markdown" aria-label="Export saved memo as Markdown"><i data-lucide="download"></i></button><button class="icon-button" type="button" id="memo-print" title="Print saved memo" aria-label="Print saved memo"><i data-lucide="printer"></i></button><button class="button secondary" type="button" id="memo-close"><i data-lucide="archive"></i>Close trade</button></div></form><article id="memo-print-view" class="print-only prose"></article></section></div>
</Layout>

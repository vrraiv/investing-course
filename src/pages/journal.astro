---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Investment journal" eyebrow="Research / Observations & decisions">
  <div slot="actions" class="page-tools"><button class="icon-button" id="export-journal" title="Export journal JSON" aria-label="Export journal JSON"><i data-lucide="download"></i></button><label class="icon-button" title="Import journal JSON"><i data-lucide="upload"></i><input id="import-journal" type="file" accept="application/json,.json" aria-label="Import journal JSON" class="file-input" /></label></div>
  <div class="editor-layout"><section><div class="section-heading"><h2 id="journal-form-title">New entry</h2><button id="journal-new" class="icon-button" title="New entry" aria-label="New entry"><i data-lucide="plus"></i></button></div><form id="journal-form" class="stack"><input name="id" type="hidden" /><div class="form-grid"><label>Date<input name="date" type="date" required /></label><label>Follow-up date<input name="followUp" type="date" /></label></div><label>Market observation<textarea name="observation" rows="4" required></textarea></label><label>Thesis update<textarea name="thesis" rows="3"></textarea></label><label>Portfolio implication<textarea name="implication" rows="3"></textarea></label><label>Confidence <output id="confidence-value">3 / 5</output><input name="confidence" type="range" min="1" max="5" value="3" /></label><button class="button" type="submit"><i data-lucide="save"></i>Save entry</button></form></section><section><div class="section-heading"><h2>Journal entries</h2><span class="tag" id="journal-total">0 ENTRIES</span></div><div id="journal-list"></div></section></div>
</Layout>
